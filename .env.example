# 配置模板：复制为 .env 使用。
# 全部配置项如下，注释掉的为默认值。

# ---- API 服务 ----
# HOST=127.0.0.1
# PORT=8189
# DATA_DIR=data
# LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
# LOG_FILE=logs/comfyui-anima-api.log    # 置空关闭文件日志
# LOG_MAX_BYTES=10485760                 # 日志单文件上限（10MB）
# LOG_BACKUP_COUNT=5                     # 保留的历史文件数

# ---- ComfyUI ----
# COMFYUI_HEALTH_TIMEOUT=5
COMFYUI_PATH=                                   # 必填：ComfyUI 项目根目录；容器部署固定 /app（见 README）
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_CLIENT_ID=comfyui-anima-api
# COMFYUI_POLL_INTERVAL=1.0
# COMFYUI_CONNECT_TIMEOUT=60

# ---- Civitai ----
# CIVITAI_LORAS_DOWNLOAD_DIR=                   # LoRA 下载位置，默认 ${COMFYUI_PATH}/models/loras
# CIVITAI_BASE_URL=https://civitai.com
# CIVITAI_EXTRA_HEADERS={}                      # JSON object 字符串
# CIVITAI_API_KEY=                              # 下载受限资源时需填写
# CIVITAI_PROXY=
# CIVITAI_CONNECT_TIMEOUT=30
# CIVITAI_READ_TIMEOUT=60
# CIVITAI_UA=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36
# CIVITAI_DOWNLOAD_TIMEOUT=1800

# ---- aria2 ----
# ARIA2_CONNECTIONS=8                           # 连接数量
# ARIA2_CONNECT_TIMEOUT=60                      # 单连接超时时间
# ARIA2_MAX_TRIES=5
# ARIA2_RETRY_WAIT=3
# ARIA2_LOWEST_SPEED_LIMIT=1K                   # 低速失败阈值

# ---- Anima 基础模型（必须与 ComfyUI models/ 各目录下的各文件名严格一致）----
# ANIMA_MODEL=anima-base-v1.0.safetensors       # models/diffusion_models/
# TEXT_ENCODER=qwen_3_06b_base.safetensors      # models/text_encoders/
# VAE=qwen_image_vae.safetensors                # models/vae/

# ---- 超分辨率模型（必须与 ComfyUI models/upscale_models/ 目录下的文件名严格一致）----
# SHARP_UPSCALE_MODEL=4x-AnimeSharp.safetensors

# ---- ControlNet 模型（必须与 ComfyUI models/controlnet/ 目录下的各文件名严格一致）----
# CONTROLNET_MIX_MODEL=anima-lllite-any-test-like-v2.safetensors
# CONTROLNET_INPAINT_MODEL=anima-lllite-inpainting-v1.safetensors
# CONTROLNET_DEPTH_MODEL=anima-lllite-depth-1.safetensors
# CONTROLNET_POSE_MODEL=anima-lllite-pose-1.safetensors
# CONTROLNET_LINEART_MODEL=anima-lllite-lineart-1.safetensors

# ---- 基础绘图参数 ----
# DEFAULT_GENERATE_SAMPLER=euler
# DEFAULT_GENERATE_SCHEDULER=simple
# DEFAULT_GENERATE_STEPS=30
# DEFAULT_GENERATE_CFG=4.5
# DEFAULT_GENERATE_IMG2IMG_DENOISE=0.6
# DEFAULT_GENERATE_SIZE=normal_portrait
# DEFAULT_GENERATE_TIMEOUT=600
# DEFAULT_TEACACHE_ENABLED=true
# DEFAULT_ANIMA_BOOSTER_SAGE_ATTENTION_ENABLED=true

# ---- Anima Booster ----
# ANIMA_BOOSTER_TORCH_COMPILE=false            # Anima Booster 模型编译

# ---- 超分辨率参数----
# SHARP_UPSCALE_BY=2.0

# ---- ControlNet 参数 ----
# DEFAULT_REFERENCE_MIX_STRENGTH=0.68
# DEFAULT_REFERENCE_INPAINT_STRENGTH=1.0
# DEFAULT_REFERENCE_DEPTH_STRENGTH=0.68
# DEFAULT_REFERENCE_POSE_STRENGTH=1.0
# DEFAULT_REFERENCE_LINEART_STRENGTH=0.68

# ---- TeaCache 参数 ----
# TEACACHE_MIN_STEPS=12
# TEACACHE_THRESHOLD=0.15
# TEACACHE_VERSION=v2 (Standard Precise)
# TEACACHE_ADAPTIVE_MODE=true
# TEACACHE_EARLY_STEPS_FACTOR=0.4
# TEACACHE_LATE_STEPS_FACTOR=1.8
# TEACACHE_START_PERCENT=0.0
# TEACACHE_END_PERCENT=1.0
# TEACACHE_CACHE_DEVICE=cuda
